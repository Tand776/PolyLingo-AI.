# Dev defaults: use the local Firebase Emulator Suite (no real project needed).
# Run `npm run emulators` (or `npm run dev:all`) alongside the client.
VITE_USE_FIREBASE_EMULATOR=true

# Demo project config — the emulator does not validate these values.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-polylingo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-polylingo
VITE_FIREBASE_STORAGE_BUCKET=demo-polylingo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demopolylingo
